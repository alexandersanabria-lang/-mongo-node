<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Nuevo Post</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
</head>
<body class="grey lighten-4">
  <nav>
    <div class="nav-wrapper teal">
      <a href="/" class="brand-logo center">Social Media</a>
    </div>
  </nav>

  <div class="container" style="margin-top: 40px;">
    <h4 class="center-align">Crear nuevo Post</h4>

    <form action="/posts" method="POST">
      <div class="input-field">
        <select name="userId" required>
          <option value="" disabled selected>Selecciona un autor</option>
          <% users.forEach(function(user) { %>
            <option value="<%= user._id %>"><%= user.name %> <%= user.lastName %></option>
          <% }); %>
        </select>
        <label>Autor</label>
      </div>

      <div class="input-field">
        <input type="text" name="title" minlength="5" maxlength="30" required>
        <label>Título</label>
      </div>

      <div class="input-field">
        <textarea class="materialize-textarea" name="content" minlength="10" required></textarea>
        <label>Contenido</label>
      </div>

      <div class="input-field">
        <input type="text" name="hashtags" placeholder="nodejs, social, práctica">
        <label class="active">Hashtags (separados por coma)</label>
      </div>

      <div class="input-field">
        <input type="text" name="imageUrl">
        <label>URL de la imagen (opcional)</label>
      </div>

      <div class="center-align">
        <button type="submit" class="btn waves-effect waves-light teal">Guardar</button>
        <a href="/posts" class="btn-flat">Cancelar</a>
      </div>
    </form>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
  <script>
    // Activa los <select> de Materialize
    document.addEventListener('DOMContentLoaded', function() {
      var elems = document.querySelectorAll('select');
      M.FormSelect.init(elems);
    });
  </script>
</body>
</html>