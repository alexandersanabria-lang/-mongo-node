<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Editar Post</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Segoe UI', system-ui, sans-serif;
      background: #0f0f14;
      color: #e4e4e7;
    }
    nav {
      background: #17171f;
      padding: 18px 24px;
      border-bottom: 1px solid #27272f;
      text-align: center;
    }
    nav a {
      text-decoration: none;
      font-size: 1.3rem;
      font-weight: 700;
      background: linear-gradient(90deg, #7c5cff, #14b8a6);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .container { max-width: 520px; margin: 40px auto; padding: 0 20px; }
    h2 { text-align: center; margin-bottom: 28px; }
    form {
      background: #17171f;
      border: 1px solid #27272f;
      border-radius: 14px;
      padding: 28px;
    }
    label { display: block; margin-bottom: 6px; font-size: 0.9rem; color: #a1a1aa; }
    input, textarea {
      width: 100%;
      background: #0f0f14;
      border: 1px solid #27272f;
      border-radius: 8px;
      padding: 12px;
      color: #e4e4e7;
      margin-bottom: 20px;
      font-family: inherit;
      font-size: 0.95rem;
    }
    textarea { resize: vertical; min-height: 90px; }
    input:focus, textarea:focus { outline: none; border-color: #7c5cff; }
    .actions { display: flex; justify-content: center; gap: 12px; margin-top: 8px; }
    .btn {
      background: linear-gradient(90deg, #7c5cff, #6d4fe0);
      color: white;
      border: none;
      padding: 12px 28px;
      border-radius: 10px;
      font-weight: 600;
      cursor: pointer;
    }
    .btn-flat { color: #a1a1aa; text-decoration: none; padding: 12px; }
  </style>
</head>
<body>
  <nav><a href="/">Social Media</a></nav>

  <div class="container">
    <h2>Editar Post</h2>
    <form action="/posts/<%= post._id %>/update" method="POST">
      <label>Título</label>
      <input type="text" name="title" value="<%= post.title %>" minlength="5" maxlength="30" required>

      <label>Contenido</label>
      <textarea name="content" minlength="10" required><%= post.content %></textarea>

      <label>Hashtags (separados por coma)</label>
      <input type="text" name="hashtags" value="<%= (post.hashtags || []).join(', ') %>">

      <label>URL de la imagen (opcional)</label>
      <input type="text" name="imageUrl" value="<%= post.imageUrl || '' %>">

      <div class="actions">
        <button type="submit" class="btn">Actualizar</button>
        <a href="/posts" class="btn-flat">Cancelar</a>
      </div>
    </form>
  </div>
</body>
</html>