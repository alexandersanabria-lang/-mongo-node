<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Editar Post</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
</head>
<body class="grey lighten-4">
  <nav>
    <div class="nav-wrapper teal">
      <a href="/" class="brand-logo center">Social Media</a>
    </div>
  </nav>

  <div class="container" style="margin-top: 40px;">
    <h4 class="center-align">Editar Post</h4>

    <form action="/posts/<%= post._id %>/update" method="POST">
      <div class="input-field">
        <input type="text" name="title" value="<%= post.title %>" minlength="5" maxlength="30" required>
        <label class="active">Título</label>
      </div>

      <div class="input-field">
        <textarea class="materialize-textarea" name="content" minlength="10" required><%= post.content %></textarea>
        <label class="active">Contenido</label>
      </div>

      <div class="input-field">
        <input type="text" name="hashtags" value="<%= (post.hashtags || []).join(', ') %>">
        <label class="active">Hashtags (separados por coma)</label>
      </div>

      <div class="input-field">
        <input type="text" name="imageUrl" value="<%= post.imageUrl || '' %>">
        <label class="active">URL de la imagen (opcional)</label>
      </div>

      <div class="center-align">
        <button type="submit" class="btn waves-effect waves-light teal">Actualizar</button>
        <a href="/posts" class="btn-flat">Cancelar</a>
      </div>
    </form>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>